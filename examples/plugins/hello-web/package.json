{
  "name": "@spark233/example-hello-web",
  "version": "0.2.0",
  "private": true,
  "description": "Independent, prebuilt example for the restricted spark233 browser SDK",
  "license": "MIT",
  "files": [
    "index.html",
    "app.css",
    "app.js",
    "sdk.js",
    "README.md",
    "assets/**"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @spark233/sdk build && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@spark233/sdk": "workspace:*"
  },
  "spark233": {
    "schemaVersion": 1,
    "id": "hello-web",
    "displayName": "Hello Web",
    "api": "^1.0.0",
    "host": ">=1.3.0 <2",
    "platforms": [
      "win32",
      "darwin",
      "linux"
    ],
    "architectures": [
      "x64",
      "arm64"
    ],
    "activation": "on-command",
    "entry": "index.html",
    "capabilities": [
      "storage"
    ],
    "commands": [
      {
        "id": "open",
        "title": "Open Hello Web",
        "keywords": [
          "hello",
          "web"
        ],
        "window": "main",
        "launcher": {
          "role": "entry"
        }
      }
    ],
    "ui": {
      "theme": "^1.0.0",
      "icon": {
        "png": "assets/icon.png",
        "ico": "assets/icon.ico"
      },
      "windows": {
        "main": {
          "entry": "index.html",
          "title": "Hello Web",
          "size": {
            "width": 720,
            "height": 560
          },
          "minSize": {
            "width": 400,
            "height": 320
          },
          "resizable": true,
          "maximizable": true,
          "taskbar": true,
          "reuse": "singleton",
          "presentation": "standard"
        }
      }
    },
    "tray": [
      {
        "id": "open",
        "commandId": "open"
      }
    ]
  }
}
