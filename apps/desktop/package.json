{
  "name": "@spark233/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Modular Windows desktop launcher and tools",
  "license": "MIT",
  "author": "spark233 contributors",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "pnpm electron:install && node scripts/dev-electron.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p electron/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "pnpm typecheck && pnpm build:assets",
    "start": "pnpm electron:install && electron .",
    "test": "vitest run",
    "test:ui": "vitest run --config vitest.browser.config.ts",
    "pack:win": "pnpm build && electron-builder --win --x64 --dir",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "electron:install": "node -e \"require('node:child_process').execFileSync(process.execPath,[require.resolve('electron/install.js')],{stdio:'inherit'})\"",
    "build:assets": "vite build && pnpm -w plugins:build && tsc -p electron/tsconfig.json && node scripts/copy-electron-assets.mjs"
  },
  "dependencies": {
    "@spark233/sdk": "workspace:*",
    "electron-updater": "6.8.12",
    "npm-package-arg": "14.0.0",
    "npm-registry-fetch": "20.0.1",
    "semver": "7.8.5",
    "ssri": "14.0.0",
    "tar": "7.5.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@spark233/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/chroma-js": "3.1.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/npm-package-arg": "6.1.4",
    "@types/npm-registry-fetch": "8.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@types/ssri": "7.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "chroma-js": "3.2.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "i18next": "26.5.11",
    "indent-textarea": "4.0.0",
    "katex": "0.19.1",
    "lucide-react": "1.64.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "build": {
    "appId": "com.spark233.desktop",
    "productName": "spark233",
    "directories": {
      "output": "../../release-electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist-electron/electron/*.test.*",
      "!node_modules/zod/src/**",
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "dist-electron/electron/mcp-relay.js",
      "dist-electron/electron/mcp-server.js",
      "dist-electron/electron/mcp-protocol.js"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "spark233-${version}-${arch}.${ext}"
    },
    "nsis": {
      "include": "electron/installer/search-service.nsh",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "bhwa233",
      "repo": "galaxy-tools",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "../../dist-host/command-matcher",
        "to": "command-matcher"
      },
      {
        "from": "../../dist-plugins",
        "to": "plugins"
      },
      {
        "from": "src/assets/fonts/LICENSE_Fonts",
        "to": "licenses/HarmonyOS_Fonts.txt"
      },
      {
        "from": "src/assets/fonts/LICENSE_SourceHanSerif",
        "to": "licenses/SourceHanSerif.txt"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Text Document",
        "role": "Editor"
      }
    ]
  }
}
