{
  "$comment": "Official plugins released to npm on their own (Docs/plugin-independent-release.md). nativeInputs are the repository sources of each plugin native component or generated data; they stand in for the files listed in generated and for native binaries in the release fingerprint.",
  "registry": "https://registry.npmjs.org/",
  "repository": "https://github.com/bhwa233/galaxy-tools.git",
  "independent": {
    "spark233.quicklinks": {
      "nativeInputs": []
    },
    "spark233.traffic": {
      "nativeInputs": ["native/traffic/**", "scripts/native-traffic/**"]
    },
    "spark233.applications": {
      "nativeInputs": [
        "native/applications/**",
        "scripts/native-applications/**",
        "packages/official/applications/build.mjs"
      ]
    },
    "spark233.search": {
      "nativeInputs": ["scripts/native-everything/**"]
    },
    "spark233.translation": {
      "nativeInputs": ["scripts/dictionary/**"],
      "generated": ["data/ecdict.sqlite", "data/provenance.json"]
    },
    "spark233.ocr": {
      "nativeInputs": [
        "native/capture/**",
        "scripts/native-capture/**",
        "packages/official/ocr/build.mjs"
      ]
    },
    "spark233.screenshot": {
      "nativeInputs": [
        "native/capture/**",
        "scripts/native-capture/**",
        "packages/official/screenshot/build.mjs"
      ]
    }
  }
}
