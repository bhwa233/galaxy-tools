{
  "name": "floral-notepaper",
  "version": "1.2.0",
  "private": true,
  "description": "Windows desktop notes built with Electron",
  "license": "MIT",
  "author": "Floral Notepaper contributors",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run electron:install && node scripts/dev-electron.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p electron/tsconfig.json && node scripts/copy-electron-assets.mjs",
    "start": "npm run electron:install && electron .",
    "test": "vitest run",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "pack:win": "npm run build && electron-builder --win --x64 --dir",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "version:sync": "node scripts/set-version.mjs",
    "prepare": "husky",
    "electron:install": "node node_modules/electron/install.js",
    "contributors:update": "node scripts/fetch-contributors.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/chroma-js": "^3.1.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "chroma-js": "^3.2.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "husky": "^9.1.7",
    "i18next": "^26.2.0",
    "indent-textarea": "^4.0.0",
    "katex": "^0.16.47",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.8.3",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,json,yml,yaml,html,md}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "build": {
    "appId": "com.floral-notepaper.electron",
    "productName": "花笺 Electron",
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist-electron/electron/*.test.*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "floral-notepaper-electron-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null,
    "extraResources": [
      {
        "from": "src/assets/fonts/LICENSE_Fonts",
        "to": "licenses/HarmonyOS_Fonts.txt"
      },
      {
        "from": "src/assets/fonts/LICENSE_SourceHanSerif",
        "to": "licenses/SourceHanSerif.txt"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Text Document",
        "role": "Editor"
      }
    ]
  }
}
