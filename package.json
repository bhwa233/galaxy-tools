{
  "name": "spark233-workspace",
  "version": "1.2.0",
  "private": true,
  "description": "spark233 desktop, shared packages and official plugins workspace",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm sdk:build && pnpm --filter @spark233/desktop dev",
    "dev:web": "pnpm --filter @spark233/desktop dev:web",
    "start": "pnpm --filter @spark233/desktop start",
    "typecheck": "pnpm sdk:build && pnpm -r --if-present typecheck",
    "build": "pnpm typecheck && pnpm ui:build && pnpm --filter @spark233/desktop build:assets",
    "plugins:build": "node scripts/build-official-plugins.mjs",
    "sdk:build": "pnpm --filter @spark233/sdk build",
    "ui:build": "pnpm --filter @spark233/ui build",
    "test": "pnpm sdk:build && pnpm --filter @spark233/desktop test",
    "test:ui": "pnpm sdk:build && pnpm --filter @spark233/desktop test:ui",
    "lint": "oxlint && node scripts/check-locales.mjs",
    "fmt": "oxfmt",
    "pack:win": "pnpm sdk:build && pnpm --filter @spark233/desktop pack:win",
    "dist:win": "pnpm sdk:build && pnpm --filter @spark233/desktop dist:win",
    "electron:install": "pnpm --filter @spark233/desktop electron:install",
    "version:sync": "node scripts/set-version.mjs",
    "contributors:update": "node scripts/fetch-contributors.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tar": "7.5.22",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,json,yml,yaml,html,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{ts,tsx,cts,mts,js,jsx,mjs,cjs}": "oxlint"
  },
  "engines": {
    "node": ">=26.12.1 <27",
    "pnpm": "12.15.0"
  },
  "packageManager": "pnpm@12.15.0"
}
