{
  "name": "@spark233/plugin-clipboard",
  "version": "0.1.4",
  "description": "spark233 local multi-format clipboard history",
  "license": "MIT",
  "files": [
    "renderer/**",
    "native/**",
    "build.mjs",
    "README.md",
    "backend.mjs",
    "backend-resources.json",
    "legal/**",
    "LICENSE",
    "assets/**",
    "config/**"
  ],
  "type": "module",
  "scripts": {
    "build": "node ../../../scripts/build-official-plugins.mjs --plugin spark233.clipboard",
    "build:native": "node build.mjs",
    "build:backend": "node build.mjs --backend-only",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@spark233/sdk": "workspace:*",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "spark233": {
    "schemaVersion": 1,
    "id": "spark233.clipboard",
    "displayName": "剪贴板历史",
    "api": "^1.0.0",
    "host": ">=1.3.0 <2",
    "platforms": [
      "win32"
    ],
    "architectures": [
      "x64"
    ],
    "activation": "on-startup",
    "capabilities": [
      "native.process",
      "storage",
      "clipboard.read",
      "clipboard.write",
      "clipboard.watch",
      "windows",
      "files.read",
      "node.backend"
    ],
    "native": {
      "clipboard": {
        "path": "native/win32-x64/spark233_clipboard_service.exe",
        "args": []
      }
    },
    "commands": [
      {
        "id": "history",
        "title": "剪贴板历史",
        "keywords": [
          "剪贴板",
          "clipboard",
          "历史",
          "cp"
        ],
        "translations": {
          "en-US": {
            "title": "Clipboard history"
          }
        },
        "launcher": {
          "role": "entry"
        },
        "window": "main"
      },
      {
        "id": "quick",
        "title": "快捷剪贴板小窗",
        "keywords": [
          "快捷剪贴板",
          "快速粘贴",
          "clipboard quick"
        ],
        "translations": {
          "en-US": {
            "title": "Quick clipboard window"
          }
        },
        "launcher": {
          "role": "hidden"
        },
        "window": "quick"
      },
      {
        "id": "pause",
        "title": "暂停或恢复剪贴板记录",
        "keywords": [
          "暂停剪贴板",
          "恢复剪贴板"
        ],
        "translations": {
          "en-US": {
            "title": "Pause or resume clipboard recording"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      }
    ],
    "modes": [
      {
        "id": "clipboard",
        "title": "剪贴板",
        "placeholder": "搜索内容、标签、备注或来源应用",
        "translations": {
          "en-US": {
            "title": "Clipboard",
            "placeholder": "Search content, tags, notes, or source applications"
          }
        }
      }
    ],
    "dependencies": {},
    "optionalDependencies": {},
    "dataVersion": 1,
    "translations": {
      "en-US": {
        "displayName": "Clipboard history"
      }
    },
    "backend": {
      "entry": "backend.mjs"
    },
    "entry": "renderer/index.html",
    "ui": {
      "theme": "^1.0.0",
      "icon": {
        "png": "assets/icon.png",
        "ico": "assets/icon.ico",
        "monochrome": true,
        "themes": {
          "green": {
            "light": {
              "png": "assets/theme-icons/green-light/icon.png",
              "ico": "assets/theme-icons/green-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/green-dark/icon.png",
              "ico": "assets/theme-icons/green-dark/icon.ico"
            }
          },
          "blue": {
            "light": {
              "png": "assets/theme-icons/blue-light/icon.png",
              "ico": "assets/theme-icons/blue-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/blue-dark/icon.png",
              "ico": "assets/theme-icons/blue-dark/icon.ico"
            }
          },
          "purple": {
            "light": {
              "png": "assets/theme-icons/purple-light/icon.png",
              "ico": "assets/theme-icons/purple-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/purple-dark/icon.png",
              "ico": "assets/theme-icons/purple-dark/icon.ico"
            }
          },
          "orange": {
            "light": {
              "png": "assets/theme-icons/orange-light/icon.png",
              "ico": "assets/theme-icons/orange-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/orange-dark/icon.png",
              "ico": "assets/theme-icons/orange-dark/icon.ico"
            }
          },
          "rose": {
            "light": {
              "png": "assets/theme-icons/rose-light/icon.png",
              "ico": "assets/theme-icons/rose-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/rose-dark/icon.png",
              "ico": "assets/theme-icons/rose-dark/icon.ico"
            }
          }
        }
      },
      "windows": {
        "main": {
          "entry": "renderer/index.html",
          "title": "剪贴板历史",
          "translations": {
            "en-US": {
              "title": "Clipboard history"
            }
          },
          "size": {
            "width": 1040,
            "height": 700
          },
          "minSize": {
            "width": 640,
            "height": 420
          },
          "resizable": true,
          "maximizable": true,
          "taskbar": true,
          "reuse": "singleton",
          "presentation": "standard",
          "legacyLabels": [
            "clipboard"
          ]
        },
        "quick": {
          "entry": "renderer/index.html",
          "title": "快捷剪贴板",
          "translations": {
            "en-US": {
              "title": "Quick clipboard"
            }
          },
          "size": {
            "width": 450,
            "height": 400
          },
          "minSize": {
            "width": 320,
            "height": 240
          },
          "resizable": true,
          "maximizable": true,
          "taskbar": true,
          "reuse": "singleton",
          "presentation": "compact",
          "legacyLabels": [
            "clipboard-quick"
          ]
        }
      }
    },
    "tray": [
      {
        "id": "history",
        "commandId": "history",
        "order": 0
      },
      {
        "id": "quick",
        "commandId": "quick",
        "order": 1
      },
      {
        "id": "pause",
        "commandId": "pause",
        "order": 2
      }
    ]
  }
}
