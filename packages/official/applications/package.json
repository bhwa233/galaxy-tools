{
  "name": "@spark233/plugin-applications",
  "version": "1.1.5",
  "private": true,
  "description": "Windows Start menu and registered application search for spark233",
  "license": "(MIT AND Apache-2.0)",
  "files": [
    "backend.mjs",
    "custom-entries.mjs",
    "migration.mjs",
    "pinyin.mjs",
    "README.md",
    "native/**",
    "licenses/**",
    "assets/**",
    "config/**"
  ],
  "type": "module",
  "scripts": {
    "build": "node ../../../scripts/build-official-plugins.mjs --plugin spark233.applications",
    "build:native": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  },
  "spark233": {
    "schemaVersion": 1,
    "id": "spark233.applications",
    "displayName": "应用搜索",
    "api": "^1.0.0",
    "host": ">=1.3.0 <2",
    "platforms": [
      "win32"
    ],
    "architectures": [
      "x64"
    ],
    "activation": "on-command",
    "backend": {
      "entry": "backend.mjs"
    },
    "capabilities": [
      "node.backend",
      "windows",
      "native.process"
    ],
    "native": {
      "pinyin": {
        "path": "native/win32-x64/spark233.ApplicationMatcher.exe",
        "args": []
      }
    },
    "commands": [
      {
        "id": "refresh",
        "title": "刷新应用列表",
        "keywords": [
          "刷新应用",
          "refresh apps"
        ],
        "translations": {
          "en-US": {
            "title": "Refresh applications"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "reveal",
        "title": "打开应用位置",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Show application location"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "copy-path",
        "title": "复制应用路径",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Copy application path or ID"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "settings",
        "title": "自定义应用入口",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Custom applications"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "search",
        "title": "搜索应用",
        "keywords": [
          "应用",
          "程序",
          "app",
          "apps"
        ],
        "mode": "apps",
        "search": "default",
        "translations": {
          "en-US": {
            "title": "Search applications"
          }
        },
        "launcher": {
          "role": "keyword-only"
        }
      },
      {
        "id": "launch",
        "title": "启动已索引应用",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Launch indexed application"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      }
    ],
    "modes": [
      {
        "id": "apps",
        "title": "应用搜索",
        "placeholder": "输入应用名称…",
        "translations": {
          "en-US": {
            "title": "Applications",
            "placeholder": "Enter an application name…"
          }
        }
      }
    ],
    "translations": {
      "en-US": {
        "displayName": "Applications"
      }
    },
    "dataVersion": 1,
    "migration": {
      "entry": "migration.mjs"
    },
    "tray": [
      {
        "id": "search",
        "commandId": "search",
        "order": 0
      }
    ],
    "ui": {
      "theme": "^1.0.0",
      "icon": {
        "png": "assets/icon.png",
        "ico": "assets/icon.ico",
        "monochrome": true,
        "themes": {
          "green": {
            "light": {
              "png": "assets/theme-icons/green-light/icon.png",
              "ico": "assets/theme-icons/green-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/green-dark/icon.png",
              "ico": "assets/theme-icons/green-dark/icon.ico"
            }
          },
          "blue": {
            "light": {
              "png": "assets/theme-icons/blue-light/icon.png",
              "ico": "assets/theme-icons/blue-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/blue-dark/icon.png",
              "ico": "assets/theme-icons/blue-dark/icon.ico"
            }
          },
          "purple": {
            "light": {
              "png": "assets/theme-icons/purple-light/icon.png",
              "ico": "assets/theme-icons/purple-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/purple-dark/icon.png",
              "ico": "assets/theme-icons/purple-dark/icon.ico"
            }
          },
          "orange": {
            "light": {
              "png": "assets/theme-icons/orange-light/icon.png",
              "ico": "assets/theme-icons/orange-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/orange-dark/icon.png",
              "ico": "assets/theme-icons/orange-dark/icon.ico"
            }
          },
          "rose": {
            "light": {
              "png": "assets/theme-icons/rose-light/icon.png",
              "ico": "assets/theme-icons/rose-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/rose-dark/icon.png",
              "ico": "assets/theme-icons/rose-dark/icon.ico"
            }
          }
        }
      }
    }
  }
}
