{
  "name": "@spark233/plugin-search",
  "version": "0.1.4",
  "description": "Pulse powered NTFS filename and Instant text search for spark233",
  "license": "Apache-2.0",
  "files": [
    "renderer/**",
    "native/**",
    "licenses/**",
    "README.md",
    "assets/**",
    "config/**"
  ],
  "type": "module",
  "scripts": {
    "build": "node ../../../scripts/build-official-plugins.mjs --plugin spark233.search"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "spark233": {
    "schemaVersion": 1,
    "id": "spark233.search",
    "displayName": "文件搜索",
    "api": "^1.0.0",
    "host": ">=1.3.0 <2",
    "platforms": [
      "win32"
    ],
    "architectures": [
      "x64"
    ],
    "activation": "on-command",
    "capabilities": [
      "native.process",
      "files.read",
      "search.index",
      "windows"
    ],
    "entry": "renderer/index.html",
    "ui": {
      "theme": "^1.0.0",
      "icon": {
        "png": "assets/icon.png",
        "ico": "assets/icon.ico",
        "monochrome": true,
        "themes": {
          "green": {
            "light": {
              "png": "assets/theme-icons/green-light/icon.png",
              "ico": "assets/theme-icons/green-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/green-dark/icon.png",
              "ico": "assets/theme-icons/green-dark/icon.ico"
            }
          },
          "blue": {
            "light": {
              "png": "assets/theme-icons/blue-light/icon.png",
              "ico": "assets/theme-icons/blue-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/blue-dark/icon.png",
              "ico": "assets/theme-icons/blue-dark/icon.ico"
            }
          },
          "purple": {
            "light": {
              "png": "assets/theme-icons/purple-light/icon.png",
              "ico": "assets/theme-icons/purple-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/purple-dark/icon.png",
              "ico": "assets/theme-icons/purple-dark/icon.ico"
            }
          },
          "orange": {
            "light": {
              "png": "assets/theme-icons/orange-light/icon.png",
              "ico": "assets/theme-icons/orange-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/orange-dark/icon.png",
              "ico": "assets/theme-icons/orange-dark/icon.ico"
            }
          },
          "rose": {
            "light": {
              "png": "assets/theme-icons/rose-light/icon.png",
              "ico": "assets/theme-icons/rose-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/rose-dark/icon.png",
              "ico": "assets/theme-icons/rose-dark/icon.ico"
            }
          }
        }
      },
      "windows": {
        "main": {
          "entry": "renderer/index.html",
          "title": "文件搜索",
          "translations": {
            "en-US": {
              "title": "File search"
            }
          },
          "size": {
            "width": 1040,
            "height": 700
          },
          "minSize": {
            "width": 640,
            "height": 420
          },
          "resizable": true,
          "maximizable": true,
          "taskbar": true,
          "reuse": "singleton",
          "presentation": "standard",
          "legacyLabels": [
            "search"
          ]
        }
      }
    },
    "native": {
      "search": {
        "path": "native/spark233.Search.exe"
      }
    },
    "dataVersion": 1,
    "commands": [
      {
        "id": "workspace",
        "title": "文件搜索",
        "keywords": [
          "搜索窗口",
          "文件搜索窗口",
          "search workspace"
        ],
        "translations": {
          "en-US": {
            "title": "File search"
          }
        },
        "launcher": {
          "role": "entry"
        },
        "window": "main"
      },
      {
        "id": "service",
        "title": "索引服务管理",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Index service management"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "reveal",
        "title": "打开文件位置",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Show file location"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "copy-path",
        "title": "复制文件路径",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Copy file path"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "preview",
        "title": "预览命中行",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Preview matching line"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "open-search",
        "title": "搜索文件",
        "keywords": [
          "文件",
          "file",
          "wj"
        ],
        "inputs": [
          "text"
        ],
        "match": "text",
        "translations": {
          "en-US": {
            "title": "Search files"
          }
        },
        "launcher": {
          "role": "action",
          "input": "query"
        },
        "window": "main"
      },
      {
        "id": "search",
        "title": "搜索文件",
        "keywords": [
          "文件",
          "file",
          "wj"
        ],
        "mode": "files",
        "translations": {
          "en-US": {
            "title": "Search files"
          }
        },
        "launcher": {
          "role": "hidden"
        },
        "window": "main"
      },
      {
        "id": "content",
        "title": "搜索文件内容",
        "keywords": [
          "正文",
          "content",
          "nr"
        ],
        "mode": "content",
        "translations": {
          "en-US": {
            "title": "Search file contents"
          }
        },
        "launcher": {
          "role": "hidden"
        },
        "window": "main"
      },
      {
        "id": "open",
        "title": "打开搜索结果",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Open search result"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "next-page",
        "title": "下一页",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Next page"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "settings",
        "title": "文件搜索范围",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "File search scope"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "install-service",
        "title": "安装文件搜索服务",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Install file search service"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      }
    ],
    "modes": [
      {
        "id": "files",
        "directoryFilter": true,
        "title": "文件",
        "placeholder": "按文件名、路径或拼音搜索",
        "translations": {
          "en-US": {
            "title": "Files",
            "placeholder": "Search names, paths, or pinyin"
          }
        }
      },
      {
        "id": "content",
        "directoryFilter": true,
        "title": "文件内容",
        "placeholder": "搜索文本、Markdown 和代码文件内容",
        "translations": {
          "en-US": {
            "title": "File contents",
            "placeholder": "Search text, Markdown, and code files"
          }
        }
      }
    ],
    "translations": {
      "en-US": {
        "displayName": "File search"
      }
    },
    "tray": [
      {
        "id": "search",
        "commandId": "workspace",
        "order": 0
      }
    ]
  }
}
