{
  "name": "@spark233/plugin-search",
  "version": "0.2.0",
  "description": "Everything 1.5 powered file name and content search for spark233",
  "license": "Apache-2.0",
  "files": [
    "native/**",
    "licenses/**",
    "README.md",
    "assets/**"
  ],
  "type": "module",
  "scripts": {
    "build": "node ../../../scripts/build-official-plugins.mjs --plugin spark233.search"
  },
  "spark233": {
    "schemaVersion": 1,
    "id": "spark233.search",
    "displayName": "文件搜索",
    "api": "^1.0.0",
    "host": ">=0.0.1 <1",
    "platforms": [
      "win32"
    ],
    "architectures": [
      "x64"
    ],
    "activation": "on-command",
    "capabilities": [
      "native.process",
      "files.read",
      "search.index"
    ],
    "ui": {
      "theme": "^1.0.0",
      "icon": {
        "png": "assets/icon.png",
        "ico": "assets/icon.ico",
        "monochrome": true,
        "themes": {
          "green": {
            "light": {
              "png": "assets/theme-icons/green-light/icon.png",
              "ico": "assets/theme-icons/green-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/green-dark/icon.png",
              "ico": "assets/theme-icons/green-dark/icon.ico"
            }
          },
          "blue": {
            "light": {
              "png": "assets/theme-icons/blue-light/icon.png",
              "ico": "assets/theme-icons/blue-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/blue-dark/icon.png",
              "ico": "assets/theme-icons/blue-dark/icon.ico"
            }
          },
          "purple": {
            "light": {
              "png": "assets/theme-icons/purple-light/icon.png",
              "ico": "assets/theme-icons/purple-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/purple-dark/icon.png",
              "ico": "assets/theme-icons/purple-dark/icon.ico"
            }
          },
          "orange": {
            "light": {
              "png": "assets/theme-icons/orange-light/icon.png",
              "ico": "assets/theme-icons/orange-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/orange-dark/icon.png",
              "ico": "assets/theme-icons/orange-dark/icon.ico"
            }
          },
          "rose": {
            "light": {
              "png": "assets/theme-icons/rose-light/icon.png",
              "ico": "assets/theme-icons/rose-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/rose-dark/icon.png",
              "ico": "assets/theme-icons/rose-dark/icon.ico"
            }
          }
        }
      }
    },
    "native": {
      "everything": {
        "path": "native/Everything.exe"
      }
    },
    "dataVersion": 1,
    "commands": [
      {
        "id": "workspace",
        "title": "打开 Everything",
        "keywords": [
          "Everything",
          "文件搜索",
          "搜索窗口",
          "search workspace"
        ],
        "translations": {
          "en-US": {
            "title": "Open Everything"
          }
        },
        "launcher": {
          "role": "entry"
        }
      },
      {
        "id": "reveal",
        "title": "打开文件位置",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Show file location"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "copy-path",
        "title": "复制文件路径",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Copy file path"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "open-search",
        "title": "在 Everything 中搜索",
        "keywords": [
          "文件",
          "file",
          "wj"
        ],
        "inputs": [
          "text"
        ],
        "match": "text",
        "translations": {
          "en-US": {
            "title": "Search in Everything"
          }
        },
        "launcher": {
          "role": "action",
          "input": "query"
        }
      },
      {
        "id": "search",
        "title": "搜索文件",
        "keywords": [
          "文件",
          "file",
          "wj"
        ],
        "mode": "files",
        "translations": {
          "en-US": {
            "title": "Search files"
          }
        },
        "launcher": {
          "role": "keyword-only"
        }
      },
      {
        "id": "content",
        "title": "搜索文件内容",
        "keywords": [
          "正文",
          "content",
          "nr"
        ],
        "mode": "content",
        "translations": {
          "en-US": {
            "title": "Search file contents"
          }
        },
        "launcher": {
          "role": "keyword-only"
        }
      },
      {
        "id": "open",
        "title": "打开搜索结果",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Open search result"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "next-page",
        "title": "下一页",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Next page"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "open-everything",
        "title": "在 Everything 中查看全部",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Show all in Everything"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "settings",
        "title": "Everything 选项",
        "internal": false,
        "translations": {
          "en-US": {
            "title": "Everything options"
          }
        },
        "launcher": {
          "role": "keyword-only"
        },
        "keywords": [
          "文件搜索范围",
          "Everything 选项",
          "everything options"
        ]
      }
    ],
    "modes": [
      {
        "id": "files",
        "directoryFilter": true,
        "title": "文件",
        "placeholder": "按文件名或路径搜索（Everything 语法）",
        "translations": {
          "en-US": {
            "title": "Files",
            "placeholder": "Search names or paths (Everything syntax)"
          }
        }
      },
      {
        "id": "content",
        "directoryFilter": true,
        "title": "文件内容",
        "placeholder": "搜索文本、Markdown 和代码文件内容",
        "translations": {
          "en-US": {
            "title": "File contents",
            "placeholder": "Search text, Markdown, and code files"
          }
        }
      }
    ],
    "translations": {
      "en-US": {
        "displayName": "File search"
      }
    },
    "tray": [
      {
        "id": "search",
        "commandId": "workspace",
        "order": 0
      }
    ]
  }
}
