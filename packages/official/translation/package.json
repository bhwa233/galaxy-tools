{
  "name": "@spark233/plugin-translation",
  "version": "0.1.4",
  "private": true,
  "description": "Offline ECDICT base dictionary and explicit OpenAI-compatible translation",
  "license": "MIT",
  "files": [
    "legal/**",
    "renderer/**",
    "backend.mjs",
    "dictionary.mjs",
    "provider.mjs",
    "language.mjs",
    "language.d.mts",
    "data/**",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "node ../../../scripts/build-official-plugins.mjs --plugin spark233.translation",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  },
  "spark233": {
    "schemaVersion": 1,
    "id": "spark233.translation",
    "displayName": "词典与翻译",
    "api": "^1.0.0",
    "host": ">=1.0.0",
    "platforms": [
      "win32"
    ],
    "architectures": [
      "x64"
    ],
    "activation": "on-command",
    "backend": {
      "entry": "backend.mjs"
    },
    "capabilities": [
      "node.backend",
      "network",
      "storage",
      "windows"
    ],
    "commands": [
      {
        "id": "search",
        "search": "word",
        "title": "本地词典",
        "keywords": [
          "词典",
          "查词",
          "dict"
        ],
        "mode": "dictionary",
        "translations": {
          "en-US": {
            "title": "Local dictionary"
          }
        }
      },
      {
        "id": "detail",
        "title": "查看词条",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "View dictionary entry"
          }
        }
      },
      {
        "id": "translate",
        "title": "AI 翻译",
        "keywords": [
          "翻译",
          "translate",
          "fy"
        ],
        "inputs": [
          "text"
        ],
        "match": "text",
        "translations": {
          "en-US": {
            "title": "AI translation"
          }
        }
      },
      {
        "id": "configure",
        "title": "配置翻译服务",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Configure translation service"
          }
        }
      },
      {
        "id": "cancel",
        "title": "取消翻译",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Cancel translation"
          }
        }
      },
      {
        "id": "status",
        "title": "翻译服务状态",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Translation service status"
          }
        }
      },
      {
        "id": "history-list",
        "title": "翻译历史",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Translation history"
          }
        }
      },
      {
        "id": "history-delete",
        "title": "删除历史条目",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Delete history entry"
          }
        }
      },
      {
        "id": "history-clear",
        "title": "清空翻译历史",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Clear translation history"
          }
        }
      },
      {
        "id": "preferences-get",
        "title": "翻译工作区偏好",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Translation workspace preferences"
          }
        }
      },
      {
        "id": "preferences-set",
        "title": "保存翻译工作区偏好",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Save translation workspace preferences"
          }
        }
      }
    ],
    "modes": [
      {
        "id": "dictionary",
        "title": "本地词典",
        "placeholder": "输入单词、词形或短语…",
        "translations": {
          "en-US": {
            "title": "Local dictionary",
            "placeholder": "Enter a word, inflection, or phrase…"
          }
        }
      }
    ],
    "translations": {
      "en-US": {
        "displayName": "Dictionary and translation"
      }
    },
    "entry": "renderer/index.html",
    "ui": {
      "theme": "^1.0.0"
    },
    "tray": [
      {
        "id": "search",
        "commandId": "search",
        "order": 0
      },
      {
        "id": "translate",
        "commandId": "translate",
        "order": 1
      }
    ]
  }
}
