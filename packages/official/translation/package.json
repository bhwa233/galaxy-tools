{
  "name": "@spark233/plugin-translation",
  "version": "0.1.8",
  "private": true,
  "description": "Offline ECDICT base dictionary and explicit OpenAI-compatible translation",
  "license": "MIT",
  "files": [
    "legal/**",
    "renderer/**",
    "backend.mjs",
    "dictionary.mjs",
    "provider.mjs",
    "language.mjs",
    "language.d.mts",
    "data/**",
    "README.md",
    "assets/**",
    "config/**"
  ],
  "type": "module",
  "scripts": {
    "build": "node ../../../scripts/build-official-plugins.mjs --plugin spark233.translation",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "i18next": "26.5.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "vitest": "5.0.5"
  },
  "spark233": {
    "schemaVersion": 1,
    "id": "spark233.translation",
    "displayName": "词典与翻译",
    "api": "^1.0.0",
    "host": ">=1.3.0 <2",
    "platforms": [
      "win32"
    ],
    "architectures": [
      "x64"
    ],
    "activation": "on-command",
    "backend": {
      "entry": "backend.mjs"
    },
    "capabilities": [
      "node.backend",
      "network",
      "storage",
      "windows"
    ],
    "commands": [
      {
        "id": "dictionary-history",
        "title": "查词历史",
        "internal": true,
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "workspace",
        "title": "本地词典",
        "keywords": [
          "词典",
          "查词",
          "dict"
        ],
        "translations": {
          "en-US": {
            "title": "Local dictionary"
          }
        },
        "launcher": {
          "role": "entry"
        },
        "window": "main"
      },
      {
        "id": "lookup",
        "title": "查词",
        "keywords": [
          "词典",
          "查词",
          "dict"
        ],
        "inputs": [
          "text"
        ],
        "match": "text",
        "translations": {
          "en-US": {
            "title": "Look up word"
          }
        },
        "launcher": {
          "role": "action",
          "input": "query"
        },
        "window": "main"
      },
      {
        "id": "search",
        "search": "word",
        "title": "本地词典",
        "keywords": [
          "词典",
          "查词",
          "dict"
        ],
        "mode": "dictionary",
        "translations": {
          "en-US": {
            "title": "Local dictionary"
          }
        },
        "launcher": {
          "role": "hidden"
        },
        "window": "main"
      },
      {
        "id": "detail",
        "title": "查看词条",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "View dictionary entry"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "translate",
        "title": "AI 翻译",
        "keywords": [
          "翻译",
          "translate",
          "fy"
        ],
        "inputs": [
          "text"
        ],
        "match": "text",
        "translations": {
          "en-US": {
            "title": "AI translation"
          }
        },
        "launcher": {
          "role": "hidden",
          "withInput": true,
          "preferSentence": true
        },
        "window": "main"
      },
      {
        "id": "configure",
        "title": "配置翻译服务",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Configure translation service"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "cancel",
        "title": "取消翻译",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Cancel translation"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "status",
        "title": "翻译服务状态",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Translation service status"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "history-list",
        "title": "翻译历史",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Translation history"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "history-delete",
        "title": "删除历史条目",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Delete history entry"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "history-clear",
        "title": "清空翻译历史",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Clear translation history"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "preferences-get",
        "title": "翻译工作区偏好",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Translation workspace preferences"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "preferences-set",
        "title": "保存翻译工作区偏好",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Save translation workspace preferences"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      }
    ],
    "modes": [
      {
        "id": "dictionary",
        "title": "本地词典",
        "placeholder": "输入单词、词形或短语…",
        "translations": {
          "en-US": {
            "title": "Local dictionary",
            "placeholder": "Enter a word, inflection, or phrase…"
          }
        }
      }
    ],
    "translations": {
      "en-US": {
        "displayName": "Dictionary and translation"
      }
    },
    "entry": "renderer/index.html",
    "ui": {
      "theme": "^1.0.0",
      "icon": {
        "png": "assets/icon.png",
        "ico": "assets/icon.ico",
        "monochrome": true,
        "themes": {
          "green": {
            "light": {
              "png": "assets/theme-icons/green-light/icon.png",
              "ico": "assets/theme-icons/green-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/green-dark/icon.png",
              "ico": "assets/theme-icons/green-dark/icon.ico"
            }
          },
          "blue": {
            "light": {
              "png": "assets/theme-icons/blue-light/icon.png",
              "ico": "assets/theme-icons/blue-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/blue-dark/icon.png",
              "ico": "assets/theme-icons/blue-dark/icon.ico"
            }
          },
          "purple": {
            "light": {
              "png": "assets/theme-icons/purple-light/icon.png",
              "ico": "assets/theme-icons/purple-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/purple-dark/icon.png",
              "ico": "assets/theme-icons/purple-dark/icon.ico"
            }
          },
          "orange": {
            "light": {
              "png": "assets/theme-icons/orange-light/icon.png",
              "ico": "assets/theme-icons/orange-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/orange-dark/icon.png",
              "ico": "assets/theme-icons/orange-dark/icon.ico"
            }
          },
          "rose": {
            "light": {
              "png": "assets/theme-icons/rose-light/icon.png",
              "ico": "assets/theme-icons/rose-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/rose-dark/icon.png",
              "ico": "assets/theme-icons/rose-dark/icon.ico"
            }
          }
        }
      },
      "windows": {
        "main": {
          "entry": "renderer/index.html",
          "title": "词典与翻译",
          "translations": {
            "en-US": {
              "title": "Dictionary and translation"
            }
          },
          "size": {
            "width": 1040,
            "height": 700
          },
          "minSize": {
            "width": 640,
            "height": 420
          },
          "resizable": true,
          "maximizable": true,
          "taskbar": true,
          "reuse": "singleton",
          "presentation": "standard",
          "legacyLabels": [
            "translation"
          ]
        }
      }
    },
    "tray": [
      {
        "id": "search",
        "commandId": "workspace",
        "order": 0
      },
      {
        "id": "translate",
        "commandId": "translate",
        "order": 1
      }
    ]
  }
}
