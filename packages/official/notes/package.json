{
  "name": "@spark233/plugin-notes",
  "version": "0.1.5",
  "license": "MIT",
  "files": [
    "legal/**",
    "backend.mjs",
    "renderer/**",
    "assets/**",
    "config/**"
  ],
  "type": "module",
  "scripts": {
    "build": "node ../../../scripts/build-official-plugins.mjs --plugin spark233.notes",
    "build:backend": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@spark233/sdk": "workspace:*",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "spark233": {
    "schemaVersion": 1,
    "id": "spark233.notes",
    "displayName": "便签",
    "api": "^1.0.0",
    "host": ">=1.3.0 <2",
    "platforms": [
      "win32"
    ],
    "architectures": [
      "x64",
      "arm64"
    ],
    "activation": "on-startup",
    "capabilities": [
      "node.backend",
      "storage",
      "windows",
      "notifications"
    ],
    "backend": {
      "entry": "backend.mjs"
    },
    "dataVersion": 1,
    "commands": [
      {
        "id": "data",
        "title": "Notes data engine",
        "internal": true,
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "desktop-note",
        "title": "贴到桌面",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Show on desktop"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "open-note",
        "title": "打开便签",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Open note"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      },
      {
        "id": "open",
        "title": "便签管理",
        "keywords": [
          "便签",
          "notes",
          "bq"
        ],
        "aliases": [
          "bianqian"
        ],
        "translations": {
          "en-US": {
            "title": "Manage notes"
          }
        },
        "launcher": {
          "role": "entry"
        },
        "window": "main"
      },
      {
        "id": "new",
        "title": "新建便签",
        "keywords": [
          "新建便签",
          "new note",
          "xjbq"
        ],
        "inputs": [
          "text",
          "image"
        ],
        "translations": {
          "en-US": {
            "title": "New note"
          }
        },
        "launcher": {
          "role": "action"
        }
      },
      {
        "id": "search",
        "title": "搜索便签",
        "keywords": [
          "搜便签",
          "note",
          "sbq"
        ],
        "mode": "notes",
        "search": "mode",
        "translations": {
          "en-US": {
            "title": "Search notes"
          }
        },
        "launcher": {
          "role": "keyword-only"
        }
      }
    ],
    "modes": [
      {
        "id": "notes",
        "title": "便签",
        "placeholder": "搜索便签标题和正文",
        "translations": {
          "en-US": {
            "title": "Notes",
            "placeholder": "Search note titles and content"
          }
        }
      }
    ],
    "translations": {
      "en-US": {
        "displayName": "Notes"
      }
    },
    "entry": "renderer/index.html",
    "ui": {
      "theme": "^1.0.0",
      "icon": {
        "png": "assets/icon.png",
        "ico": "assets/icon.ico",
        "monochrome": true,
        "themes": {
          "green": {
            "light": {
              "png": "assets/theme-icons/green-light/icon.png",
              "ico": "assets/theme-icons/green-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/green-dark/icon.png",
              "ico": "assets/theme-icons/green-dark/icon.ico"
            }
          },
          "blue": {
            "light": {
              "png": "assets/theme-icons/blue-light/icon.png",
              "ico": "assets/theme-icons/blue-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/blue-dark/icon.png",
              "ico": "assets/theme-icons/blue-dark/icon.ico"
            }
          },
          "purple": {
            "light": {
              "png": "assets/theme-icons/purple-light/icon.png",
              "ico": "assets/theme-icons/purple-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/purple-dark/icon.png",
              "ico": "assets/theme-icons/purple-dark/icon.ico"
            }
          },
          "orange": {
            "light": {
              "png": "assets/theme-icons/orange-light/icon.png",
              "ico": "assets/theme-icons/orange-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/orange-dark/icon.png",
              "ico": "assets/theme-icons/orange-dark/icon.ico"
            }
          },
          "rose": {
            "light": {
              "png": "assets/theme-icons/rose-light/icon.png",
              "ico": "assets/theme-icons/rose-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/rose-dark/icon.png",
              "ico": "assets/theme-icons/rose-dark/icon.ico"
            }
          }
        }
      },
      "windows": {
        "main": {
          "entry": "renderer/index.html",
          "title": "便签管理",
          "translations": {
            "en-US": {
              "title": "Notes"
            }
          },
          "size": {
            "width": 1180,
            "height": 760
          },
          "minSize": {
            "width": 900,
            "height": 620
          },
          "resizable": true,
          "maximizable": true,
          "taskbar": true,
          "reuse": "singleton",
          "presentation": "standard"
        },
        "notepad": {
          "entry": "renderer/index.html",
          "title": "快速记事",
          "translations": {
            "en-US": {
              "title": "Quick Note"
            }
          },
          "size": {
            "width": 720,
            "height": 620
          },
          "minSize": {
            "width": 160,
            "height": 60
          },
          "resizable": true,
          "maximizable": true,
          "taskbar": true,
          "reuse": "document",
          "presentation": "standard"
        },
        "tile": {
          "entry": "renderer/index.html",
          "title": "便签",
          "translations": {
            "en-US": {
              "title": "Note"
            }
          },
          "size": {
            "width": 360,
            "height": 420
          },
          "minSize": {
            "width": 160,
            "height": 60
          },
          "resizable": true,
          "maximizable": true,
          "taskbar": true,
          "reuse": "document",
          "presentation": "standard"
        }
      }
    },
    "tray": [
      {
        "id": "open",
        "commandId": "open",
        "order": 0
      },
      {
        "id": "new",
        "commandId": "new",
        "order": 1
      },
      {
        "id": "search",
        "commandId": "search",
        "order": 2
      }
    ]
  }
}
