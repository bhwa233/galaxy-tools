{
  "name": "@spark233/plugin-notes",
  "version": "0.1.4",
  "license": "MIT",
  "files": [
    "legal/**",
    "backend.mjs",
    "renderer/**"
  ],
  "type": "module",
  "scripts": {
    "build": "node ../../../scripts/build-official-plugins.mjs --plugin spark233.notes",
    "build:backend": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@spark233/sdk": "workspace:*",
    "@types/node": "24.19.2",
    "electron": "45.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "spark233": {
    "schemaVersion": 1,
    "id": "spark233.notes",
    "displayName": "便签",
    "api": "^1.0.0",
    "host": ">=1.2.0 <2",
    "platforms": [
      "win32"
    ],
    "architectures": [
      "x64",
      "arm64"
    ],
    "activation": "on-startup",
    "capabilities": [
      "node.backend",
      "storage",
      "windows",
      "notifications"
    ],
    "backend": {
      "entry": "backend.mjs"
    },
    "dataVersion": 1,
    "commands": [
      {
        "id": "data",
        "title": "Notes data engine",
        "internal": true
      },
      {
        "id": "desktop-note",
        "title": "贴到桌面",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Show on desktop"
          }
        }
      },
      {
        "id": "open-note",
        "title": "打开便签",
        "internal": true,
        "translations": {
          "en-US": {
            "title": "Open note"
          }
        }
      },
      {
        "id": "open",
        "title": "便签管理",
        "keywords": [
          "便签",
          "notes",
          "bq"
        ],
        "aliases": [
          "bianqian"
        ],
        "translations": {
          "en-US": {
            "title": "Manage notes"
          }
        }
      },
      {
        "id": "new",
        "title": "新建便签",
        "keywords": [
          "新建便签",
          "new note",
          "xjbq"
        ],
        "inputs": [
          "text",
          "image"
        ],
        "translations": {
          "en-US": {
            "title": "New note"
          }
        }
      },
      {
        "id": "search",
        "title": "搜索便签",
        "keywords": [
          "搜便签",
          "note",
          "sbq"
        ],
        "mode": "notes",
        "search": "mode",
        "translations": {
          "en-US": {
            "title": "Search notes"
          }
        }
      }
    ],
    "modes": [
      {
        "id": "notes",
        "title": "便签",
        "placeholder": "搜索便签标题和正文",
        "translations": {
          "en-US": {
            "title": "Notes",
            "placeholder": "Search note titles and content"
          }
        }
      }
    ],
    "translations": {
      "en-US": {
        "displayName": "Notes"
      }
    },
    "entry": "renderer/index.html",
    "ui": {
      "theme": "^1.0.0"
    },
    "tray": [
      {
        "id": "open",
        "commandId": "open",
        "order": 0
      },
      {
        "id": "new",
        "commandId": "new",
        "order": 1
      },
      {
        "id": "search",
        "commandId": "search",
        "order": 2
      }
    ]
  }
}
