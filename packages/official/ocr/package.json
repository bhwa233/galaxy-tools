{
  "name": "@spark233/plugin-ocr",
  "version": "0.1.2",
  "description": "spark233 offline ImageReader OCR with embedded models",
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md",
  "files": [
    "renderer/**",
    "native/**",
    "legal/**",
    "build.mjs",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "assets/**",
    "config/**"
  ],
  "type": "module",
  "scripts": {
    "build": "node ../../../scripts/build-official-plugins.mjs --plugin spark233.ocr",
    "build:native": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "spark233": {
    "schemaVersion": 1,
    "id": "spark233.ocr",
    "displayName": "图片取字",
    "api": "^1.0.0",
    "host": ">=1.3.0 <2",
    "platforms": [
      "win32"
    ],
    "architectures": [
      "x64"
    ],
    "activation": "on-command",
    "capabilities": [
      "native.process",
      "storage",
      "files.read",
      "windows"
    ],
    "native": {
      "ocr": {
        "path": "native/win32-x64/ImageReader.exe",
        "args": []
      }
    },
    "commands": [
      {
        "id": "ocr",
        "title": "识别图片文字",
        "keywords": [
          "图片取字",
          "ocr"
        ],
        "inputs": [
          "image"
        ],
        "match": "image",
        "translations": {
          "en-US": {
            "title": "Recognize image text"
          }
        },
        "launcher": {
          "role": "action"
        },
        "progress": {
          "title": "取消文字识别",
          "cancelCommand": "cancel",
          "translations": {
            "en-US": {
              "title": "Cancel text recognition"
            }
          }
        }
      },
      {
        "id": "cancel",
        "title": "取消文字识别",
        "keywords": [
          "取消识别"
        ],
        "translations": {
          "en-US": {
            "title": "Cancel text recognition"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      }
    ],
    "dependencies": {},
    "optionalDependencies": {},
    "dataVersion": 1,
    "translations": {
      "en-US": {
        "displayName": "Image text recognition"
      }
    },
    "entry": "renderer/index.html",
    "ui": {
      "theme": "^1.0.0",
      "icon": {
        "png": "assets/icon.png",
        "ico": "assets/icon.ico",
        "monochrome": true,
        "themes": {
          "green": {
            "light": {
              "png": "assets/theme-icons/green-light/icon.png",
              "ico": "assets/theme-icons/green-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/green-dark/icon.png",
              "ico": "assets/theme-icons/green-dark/icon.ico"
            }
          },
          "blue": {
            "light": {
              "png": "assets/theme-icons/blue-light/icon.png",
              "ico": "assets/theme-icons/blue-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/blue-dark/icon.png",
              "ico": "assets/theme-icons/blue-dark/icon.ico"
            }
          },
          "purple": {
            "light": {
              "png": "assets/theme-icons/purple-light/icon.png",
              "ico": "assets/theme-icons/purple-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/purple-dark/icon.png",
              "ico": "assets/theme-icons/purple-dark/icon.ico"
            }
          },
          "orange": {
            "light": {
              "png": "assets/theme-icons/orange-light/icon.png",
              "ico": "assets/theme-icons/orange-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/orange-dark/icon.png",
              "ico": "assets/theme-icons/orange-dark/icon.ico"
            }
          },
          "rose": {
            "light": {
              "png": "assets/theme-icons/rose-light/icon.png",
              "ico": "assets/theme-icons/rose-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/rose-dark/icon.png",
              "ico": "assets/theme-icons/rose-dark/icon.ico"
            }
          }
        }
      },
      "windows": {
        "result": {
          "entry": "renderer/index.html",
          "title": "取字结果",
          "translations": {
            "en-US": {
              "title": "Recognized text"
            }
          },
          "size": {
            "width": 1040,
            "height": 700
          },
          "minSize": {
            "width": 640,
            "height": 420
          },
          "resizable": true,
          "maximizable": true,
          "taskbar": true,
          "reuse": "singleton",
          "presentation": "standard",
          "legacyLabels": [
            "ocr"
          ]
        }
      }
    },
    "tray": [
      {
        "id": "ocr",
        "commandId": "ocr",
        "order": 0
      }
    ]
  }
}
