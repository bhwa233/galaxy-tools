{
  "name": "@spark233/plugin-screenshot",
  "version": "0.1.4",
  "description": "spark233 native screenshot and optional OCR transfer",
  "license": "MIT",
  "files": [
    "native/**",
    "legal/**",
    "build.mjs",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "assets/**",
    "config/**"
  ],
  "type": "module",
  "scripts": {
    "build": "node ../../../scripts/build-official-plugins.mjs --plugin spark233.screenshot",
    "build:native": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "spark233": {
    "schemaVersion": 1,
    "id": "spark233.screenshot",
    "displayName": "截图",
    "api": "^1.1.0",
    "host": ">=0.0.1 <1",
    "platforms": [
      "win32"
    ],
    "architectures": [
      "x64"
    ],
    "activation": "on-command",
    "capabilities": [
      "native.process",
      "storage",
      "windows"
    ],
    "native": {
      "capture": {
        "path": "native/win32-x64/ScreenCapture.exe",
        "args": []
      }
    },
    "commands": [
      {
        "id": "history",
        "title": "截图历史",
        "keywords": [
          "截图历史",
          "截图记录",
          "screenshot history"
        ],
        "translations": {
          "en-US": {
            "title": "Screenshot history"
          }
        },
        "launcher": {
          "role": "entry"
        },
        "window": "history"
      },
      {
        "id": "capture",
        "title": "截图",
        "keywords": [
          "截图",
          "screenshot",
          "jt"
        ],
        "translations": {
          "en-US": {
            "title": "Take screenshot"
          }
        },
        "launcher": {
          "role": "action"
        }
      },
      {
        "id": "ocr",
        "title": "截图取字",
        "requiresPlugins": [
          "spark233.ocr"
        ],
        "keywords": [
          "截图取字",
          "ocr",
          "文字识别"
        ],
        "translations": {
          "en-US": {
            "title": "Capture and recognize text"
          }
        },
        "launcher": {
          "role": "action"
        }
      },
      {
        "id": "cancel",
        "title": "取消当前截图",
        "keywords": [
          "取消截图"
        ],
        "translations": {
          "en-US": {
            "title": "Cancel screenshot"
          }
        },
        "launcher": {
          "role": "hidden"
        }
      }
    ],
    "dependencies": {},
    "optionalDependencies": {
      "spark233.ocr": "^0.1.0"
    },
    "dataVersion": 1,
    "translations": {
      "en-US": {
        "displayName": "Screenshot"
      }
    },
    "tray": [
      {
        "id": "capture",
        "commandId": "capture",
        "order": 0
      }
    ],
    "ui": {
      "theme": "^1.0.0",
      "icon": {
        "png": "assets/icon.png",
        "ico": "assets/icon.ico",
        "monochrome": true,
        "themes": {
          "green": {
            "light": {
              "png": "assets/theme-icons/green-light/icon.png",
              "ico": "assets/theme-icons/green-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/green-dark/icon.png",
              "ico": "assets/theme-icons/green-dark/icon.ico"
            }
          },
          "blue": {
            "light": {
              "png": "assets/theme-icons/blue-light/icon.png",
              "ico": "assets/theme-icons/blue-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/blue-dark/icon.png",
              "ico": "assets/theme-icons/blue-dark/icon.ico"
            }
          },
          "purple": {
            "light": {
              "png": "assets/theme-icons/purple-light/icon.png",
              "ico": "assets/theme-icons/purple-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/purple-dark/icon.png",
              "ico": "assets/theme-icons/purple-dark/icon.ico"
            }
          },
          "orange": {
            "light": {
              "png": "assets/theme-icons/orange-light/icon.png",
              "ico": "assets/theme-icons/orange-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/orange-dark/icon.png",
              "ico": "assets/theme-icons/orange-dark/icon.ico"
            }
          },
          "rose": {
            "light": {
              "png": "assets/theme-icons/rose-light/icon.png",
              "ico": "assets/theme-icons/rose-light/icon.ico"
            },
            "dark": {
              "png": "assets/theme-icons/rose-dark/icon.png",
              "ico": "assets/theme-icons/rose-dark/icon.ico"
            }
          }
        }
      },
      "windows": {
        "history": {
          "entry": "renderer/index.html",
          "title": "截图历史",
          "translations": {
            "en-US": {
              "title": "Screenshot history"
            }
          },
          "size": {
            "width": 1040,
            "height": 700
          },
          "minSize": {
            "width": 640,
            "height": 420
          },
          "resizable": true,
          "maximizable": true,
          "taskbar": true,
          "reuse": "singleton",
          "presentation": "standard",
          "legacyLabels": [
            "screenshot-history"
          ]
        }
      }
    }
  }
}
